# Exemplo de ambiente do rendai. SÓ NOMES: os valores ficam no Infisical (rt-produtos/rendai, ambiente prod) e chegam à VPS no deploy. Nunca commitar valores.
# Em desenvolvimento local basta copiar para .env e preencher o que for usar; sem SMTP/LLM o app roda em modo de desenvolvimento.

RENDAI_ADMIN_KEY=
RENDAI_CAKTO_SEGREDO=
RENDAI_CHECKOUT_MENSAL=
RENDAI_DEMO_SENHA=
RENDAI_LLM_KEY=
RENDAI_SEGREDO_SESSAO=
RENDAI_SMTP_FROM=
SMTP_HOST=
SMTP_PASSWORD=
SMTP_PORT=
SMTP_USER=
